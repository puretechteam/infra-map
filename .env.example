# Infra Map Environment Variables

# Application environment: development, production, or testing
FLASK_ENV=development

# Path to the data directory containing data_centers.json
DATA_PATH=./data

# Cache time-to-live in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Host address for the Flask development server
HOST=0.0.0.0

# Port for the Flask development server
PORT=5000

# Path to the cache directory for storing fetched data
CACHE_DIR=./cache

# External data fetch timeout in seconds
FETCH_TIMEOUT=30

# Maximum number of retries for external data fetching
FETCH_MAX_RETRIES=3

# Whether to enable debug mode (set to False in production)
DEBUG=True